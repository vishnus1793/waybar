[
  // ==========================================
  // BAR 1: MAIN LAPTOP DISPLAY (eDP-1)
  // ==========================================
  {
    "output": "eDP-1",
    "layer": "top",
    "mode": "dock",
    "height": 0,
    "width": 0,
    "margin": 0,
    "spacing": 0,
    "reload_style_on_change": true,

    "include": [
      "~/.config/waybar/modules/*.jsonc",
      "~/.config/waybar/modules/custom/*.jsonc",
      "~/.config/waybar/modules/hyprland/*.jsonc"
    ],

    "modules-left": [
      "custom/user",
      "custom/left_div#1",
      "hyprland/workspaces",
      "custom/right_div#1",
      "hyprland/window"
    ],

    "modules-center": [
      "custom/left_div#2",
      "temperature",
      "custom/left_div#3",
      "memory",
      "custom/left_div#4",
      "cpu",
      "custom/left_inv#1",
      "custom/left_div#5",
      "custom/distro",
      "custom/right_div#2",
      "custom/right_inv#1",
      "idle_inhibitor",
      "clock#time",
      "custom/right_div#3",
      "clock#date",
      "custom/right_div#4",
      "custom/netgraph",
      "network",
      "bluetooth",
      "custom/update",
      "custom/right_div#5"
    ],

    "modules-right": [
      "mpris",
      "custom/uptime",
      "custom/phone-battery",
      "custom/bluetooth",
      "custom/left_div#6",
      "group/pulseaudio",
      "custom/left_div#7",
      "backlight",
      "custom/left_div#8",
      "battery",
      "custom/left_inv#2",
      "custom/power"
    ]
  },

  // ==========================================
  // BAR 2: 20-INCH EXTERNAL DISPLAY (HDMI-A-1)
  // ==========================================
  {
    "output": "HDMI-A-1",
    "layer": "top",
    "mode": "dock",
    "height": 0,
    "width": 0,
    "margin": 0,
    "spacing": 0,
    "reload_style_on_change": true,

    "include": [
      "~/.config/waybar/modules/*.jsonc",
      "~/.config/waybar/modules/custom/*.jsonc",
      "~/.config/waybar/modules/hyprland/*.jsonc"
    ],

    // Cleaned up for a perfect 20" scale fitment
    "modules-left": [
      "custom/user",
      "hyprland/workspaces",
      "hyprland/window"
    ],

    "modules-center": [
      "clock#time",
      "clock#date"
    ],

    "modules-right": [
      "group/pulseaudio",
      "battery",
      "custom/power"
    ]
  }
]
